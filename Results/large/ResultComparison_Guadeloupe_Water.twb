      <column caption='Calculation2' datatype='real' name='[Calculation_186617959420755968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Technology]==&apos;FRT_Road_ICE&apos; THEN [Value ]/2 ELSE [Value ]END' />
