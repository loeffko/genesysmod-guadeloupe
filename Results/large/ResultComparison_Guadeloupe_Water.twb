        <calculation class='tableau' formula='FLOAT(IF [Calculation_2067433755484999680]&gt;0.5 &#13;&#10;&#13;&#10;THEN &#13;&#10;&#13;&#10;    IF MID([Model Version],23,1)==&quot;_&quot; &#13;&#10;    THEN MID([Model Version],22,1)&#13;&#10;    ELSE MID([Model Version],22,2)&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    IF MID([Model Version],22,1)==&quot;_&quot; &#13;&#10;    THEN MID([Model Version],21,1)&#13;&#10;    ELSE MID([Model Version],21,2)&#13;&#10;    END&#13;&#10;&#13;&#10;END)' />
      </column>
